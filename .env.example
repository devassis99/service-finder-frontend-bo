# Base URL of service-finder-backend, no trailing slash.
VITE_API_BASE_URL=http://localhost:4000

# Same Google Cloud Console OAuth 2.0 Web Client ID as the backend's
# GOOGLE_CLIENT_ID (apps/api/.env in service-finder-backend). The backend
# verifies its token audience against this exact client id, so the two
# MUST match. http://localhost:5273 has to be one of the client's
# Authorised JavaScript origins, or Google's button won't render.
VITE_GOOGLE_CLIENT_ID=
